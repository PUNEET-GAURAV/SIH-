# DocShield AI Environment Configuration
# Copy to .env and adjust values

# Application
APP_NAME=DocShield AI
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-a-random-64-char-string
MOCK_MODE=false

# Database
DATABASE_URL=postgresql://docshield:docshield@localhost:5432/docshield
# For development without PostgreSQL:
# DATABASE_URL=sqlite:///./docshield.db

# Auth
JWT_SECRET_KEY=change-me-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# Model Paths (leave empty to use defaults or trigger MODEL_UNAVAILABLE)
MODEL_DIR=./models
OCR_MODEL_PATH=
FACE_MODEL_PATH=
FORENSIC_MODEL_PATH=

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=INFO
